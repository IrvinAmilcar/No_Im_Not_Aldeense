      m_Calls: []
  m_text: "<size=80%>Um projeto da cadeira de estat\xEDstica e probabilidade</size>\n<size=80%>Cesar
    School - Ci\xEAncia da Computa\xE7\xE3o</size>\n\n\n<size=120%><b>DIRE\xC7\xC3O
    & NARRATIVA</b></size>\n\n<b>Matheus Martins</b>\nGame Director\nWriter\n\n\n<size=120%><b>ARTE
    & VISUAL</b></size>\n\n<b>Maria Claudia</b>\nArts Director\nSprites\n\n\n<size=120%><b>LEVEL
    DESIGN</b></size>\n\n<b>Irvin Amilcar</b>\nLevel Designer\n\n\n<size=120%><b>PROGRAMA\xC7\xC3O</b></size>\n\n<b>Matheus
    Martins</b>\nLead Programmer\n\n<b>Irvin Amilcar</b>\nProgrammer\n\n<b>Vinicius
    Marques</b>\nProgrammer\n\n<b>Fabiana Coelho</b>\nProgrammer\n\n<b>Julia Maria</b>\nProgrammer\n\n<b>Amanda
    Montarroios</b>\nProgrammer\n\n\n<size=120%><b>AGRADECIMENTO ESPECIAL</b></size>\n\nProfessor
    <b>Guilherme Pereira</b>\npela orienta\xE7\xE3o na cadeira de Estat\xEDstica.\n\n\n<size=80%>Obrigado
    por jogar!</size>"
  m_isRightToLeft: 0
