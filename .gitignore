### Unity ###
#
# This file should be placed in the root of your Unity project directory
#
# Get latest from https://github.com/github/gitignore/blob/main/Unity.gitignore
#
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/

# MemoryCaptures can be vital in finding memory leaks.
# Remove MemoryCaptures from .gitignore if you want to share the files with other developers.
/[Mm]emory[Cc]aptures/

# Visual Studio cache files
.vs/
.vsconfig
.sln
.csproj
.unityproj
.suo

# Rider cache files
.idea/

# Autogenerated project files
*.sln.DotSettings.user
*.suo.DotSettings.user
*.sln.Startup.user

# Unity3D generated file on crash reports
sysinfo.txt

# Builds
*.apk
*.aab
*.app
*.exe
*.ipa
*.xap

# Crashlytics generated file
crashlytics-build.properties

# Gradle cache files
.gradle/
build/

# Other
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db