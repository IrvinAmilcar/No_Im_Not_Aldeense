# ============================================================================
# Unity .gitignore - URP 3D Project
# Para equipe com Mac e Windows
# ============================================================================

# ============================================================================
# UNITY - Arquivos gerados automaticamente
# ============================================================================
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]ser[Ss]ettings/

# MemoryCaptures - Comente se precisar compartilhar capturas de memória
[Mm]emory[Cc]aptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Uncomment this line if you wish to ignore the asset store tools plugin
# /[Aa]ssets/AssetStoreTools*

# Autogenerated Jetbrains Rider plugin
[Aa]ssets/Plugins/Editor/JetBrains*

# ============================================================================
# VISUAL STUDIO / VISUAL STUDIO CODE
# ============================================================================
.vscode/
.vs/
*.csproj
*.unityproj
*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# ============================================================================
# RIDER
# ============================================================================
.idea/
*.sln.iml

# ============================================================================
# MACOS
# ============================================================================
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon

# Thumbnails
._*

# Files that might appear in the root of a volume
.DocumentRevisions-V100
.fseventsd
.TemporaryItems
.VolumeIcon.icns
.com.apple.timemachine.donotpresent

# ============================================================================
# WINDOWS
# ============================================================================
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
*.stackdump
[Dd]esktop.ini
$RECYCLE.BIN/
*.cab
*.msi
*.msix
*.msm
*.msp
*.lnk

# ============================================================================
# LINUX
# ============================================================================
*~
.directory
.Trash-*

# ============================================================================
# CRASH LOGS
# ============================================================================
sysinfo.txt
*.stackdump
crashlytics-build.properties

# ============================================================================
# BUILDS - Arquivos de build não devem ser versionados
# ============================================================================
*.apk
*.aab
*.unitypackage
*.app
*.exe
*.x86
*.x86_64
*.ipa
*.xap

# ============================================================================
# GRADLE (para Android builds)
# ============================================================================
.gradle/
Gradle/

# ============================================================================
# OUTROS
# ============================================================================
# Plastic SCM
.plastic/

# Autodesk Fbx Converter
FBXMaxExport.txt

# Unity-specific .meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity Package Manager - Packages são gerenciados pelo manifest.json
[Pp]ackages/
# Mas mantenha o manifest.json e o lock file
![Pp]ackages/manifest.json
![Pp]ackages/packages-lock.json

# ============================================================================
# ARQUIVOS DO PROJETO - IMPORTANTES!
# ============================================================================
# Estes arquivos DEVEM ser versionados:
# - ProjectSettings/
# - Assets/
# - Packages/manifest.json
# - Packages/packages-lock.json

# ============================================================================
# CUSTOM - Adicione aqui arquivos específicos do seu projeto
# ============================================================================
# Exemplo: ignorar pasta de testes locais
# /LocalTests/

# Exemplo: ignorar assets de teste
# /Assets/TestAssets/
